ANTHROPIC_API_KEY=
EXA_API_KEY=
# Google: run `npx tsx scripts/auth-google.ts` once after placing credentials.json here
SCHOOL_CALENDAR_ID=
TZ=America/Los_Angeles
# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=school-helper
# Optional: comma-separated phone numbers allowed to use the agent
WHATSAPP_ALLOWED_FROM=
# Only for org-level keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
EXTRA_CALENDAR_IDS=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
# Set by `neon link` / `neon deploy`; when present the chat agent uses the Neon AI Gateway
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=
