# Model
ANTHROPIC_API_KEY=
# Only for org-level keys that are not scoped to a workspace
ANTHROPIC_WORKSPACE_ID=
# Set by `neon link` / `neon deploy`; when present the chat agent uses the Neon AI Gateway
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_BASE_URL=

# School website lookup
EXA_API_KEY=

# Google Calendar: run `npx tsx scripts/auth-google.ts` once after placing credentials.json here,
# then `npx tsx scripts/school-calendar.ts` to create the School calendar and print its id
SCHOOL_CALENDAR_ID=
# Optional: other calendars that already hold school events (e.g. the district's public calendar)
EXTRA_CALENDAR_IDS=
TZ=America/Los_Angeles

# Email channel: `npx tsx scripts/setup-agentmail.ts https://<host>` fills the last two
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta for Developers > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=school-helper
# Optional: comma-separated phone numbers allowed to use the agent
WHATSAPP_ALLOWED_FROM=

# Access: set APP_TOKEN to require a family code on the dashboard, sync, and chat; ALLOWED_SENDERS to
# restrict the email channel. Both unset means open (demo only).
APP_TOKEN=
ALLOWED_SENDERS=
